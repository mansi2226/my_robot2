<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name ="my_robot">
    

     <xacro:arg name="use_ros2_control" default="true"/>

     <xacro:include filename="$(find robot_description)/urdf/robot_core.xacro" />

     <!-- <xacro:include filename="$(find robot_description)/urdf/gazebo_control.xacro" /> -->

     <xacro:if value="$(arg use_ros2_control)">
      <xacro:include filename="$(find robot_description)/urdf/ros2_control.xacro" />
     </xacro:if>


     <xacro:unless value="$(arg use_ros2_control)">
      <xacro:include filename="$(find robot_description)/urdf/gazebo_control.xacro" />
     </xacro:unless>

     <xacro:include filename="$(find robot_description)/urdf/lidar.xacro" />
    
    


</robot>      